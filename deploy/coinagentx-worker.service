[Unit]
Description=CoinAgentX Simple Reversal Futures Scanner (PAPER ONLY)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/coinagentx
EnvironmentFile=/opt/coinagentx/.env
Environment=PYTHONUNBUFFERED=1
Environment=SCAN_INTERVAL_SECONDS=60
Environment=SCAN_SYMBOLS=50
Environment=PAPER_INITIAL_EQUITY=1000
Environment=PAPER_RISK_PCT=0.5
Environment=PAPER_LEVERAGE=2
ExecStart=/usr/bin/python3 /opt/coinagentx/worker.py --interval 60 --symbols 50 --initial-equity 1000 --risk-pct 0.5 --leverage 2
Restart=always
RestartSec=10
MemoryMax=512M

[Install]
WantedBy=multi-user.target
